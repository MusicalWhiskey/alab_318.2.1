<!DOCTYPE html>
<html>
<head>
  <title>Main</title>
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
    }
    nav {
      position: absolute;
      top: 20px;
      left: 20px;
    }
    form {
      display: flex;
      flex-direction: column;
      align-items: center;
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    input[type="text"] {
      margin-bottom: 10px;
      padding: 8px;
      width: 200px;
    }
    button {
      padding: 10px 20px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
    }
    button:hover {
      background-color: #0056b3;
    }
    .image-container {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  </style>
</head>
<body>
  <nav>
    <a href="/info">Info</a>
  </nav>
  <div class="image-container">
    <img src="/static/Funny_Dog_Detective.jpg" alt="dog_detective" style="max-width: 100%; height: auto;">
    <form action="/download" method="GET">
      <button type="submit">Download Image</button>
    </form>
  </div>
</body>
</html>
